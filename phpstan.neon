includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - app
        - bootstrap/app.php
        - bootstrap/providers.php
        - database
        - modules
        - routes
    excludePaths:
        - modules/*/tests/*
        # Config files read env(), which is correct there (as for the root config/).
        - modules/*/config/*
    tmpDir: storage/framework/cache/phpstan
