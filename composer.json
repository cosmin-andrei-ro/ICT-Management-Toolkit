{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ict-management-toolkit/ict-management-toolkit",
    "type": "project",
    "description": "Open-source platform that centralizes a company's IT information: ITSM, CMDB, ITAM, DCIM, BIA, BCM, risk and compliance.",
    "keywords": [
        "itsm",
        "itil",
        "cmdb",
        "itam",
        "dcim",
        "grc",
        "laravel"
    ],
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.3",
        "chillerlan/php-qrcode": "^5.0",
        "dedoc/scramble": "^0.13.52",
        "directorytree/imapengine": "^1.25",
        "directorytree/ldaprecord": "^4.1",
        "filament/filament": "^5.11",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.4",
        "openspout/openspout": "^4.23",
        "spatie/laravel-permission": "^8.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.69",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\Core\\": "modules/Core/src/",
            "Modules\\Core\\Database\\Factories\\": "modules/Core/database/factories/",
            "Modules\\Core\\Database\\Seeders\\": "modules/Core/database/seeders/",
            "Modules\\Ticketing\\": "modules/Ticketing/src/",
            "Modules\\Ticketing\\Database\\Factories\\": "modules/Ticketing/database/factories/",
            "Modules\\Ticketing\\Database\\Seeders\\": "modules/Ticketing/database/seeders/",
            "Modules\\Cmdb\\": "modules/Cmdb/src/",
            "Modules\\Cmdb\\Database\\Factories\\": "modules/Cmdb/database/factories/",
            "Modules\\Itam\\": "modules/Itam/src/",
            "Modules\\Itam\\Database\\Factories\\": "modules/Itam/database/factories/",
            "Modules\\Bia\\": "modules/Bia/src/",
            "Modules\\Bia\\Database\\Factories\\": "modules/Bia/database/factories/",
            "Modules\\Bcm\\": "modules/Bcm/src/",
            "Modules\\Bcm\\Database\\Factories\\": "modules/Bcm/database/factories/",
            "Modules\\Applications\\": "modules/Applications/src/",
            "Modules\\Applications\\Database\\Factories\\": "modules/Applications/database/factories/",
            "Modules\\Risk\\": "modules/Risk/src/",
            "Modules\\Risk\\Database\\Factories\\": "modules/Risk/database/factories/",
            "Modules\\Audit\\": "modules/Audit/src/",
            "Modules\\Audit\\Database\\Factories\\": "modules/Audit/database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Tests\\Fixtures\\DummyModule\\": "tests/Fixtures/modules/Dummy/src/",
            "Modules\\Core\\Tests\\": "modules/Core/tests/",
            "Modules\\Ticketing\\Tests\\": "modules/Ticketing/tests/",
            "Modules\\Cmdb\\Tests\\": "modules/Cmdb/tests/",
            "Modules\\Itam\\Tests\\": "modules/Itam/tests/",
            "Modules\\Bia\\Tests\\": "modules/Bia/tests/",
            "Modules\\Bcm\\Tests\\": "modules/Bcm/tests/",
            "Modules\\Applications\\Tests\\": "modules/Applications/tests/",
            "Modules\\Risk\\Tests\\": "modules/Risk/tests/",
            "Modules\\Audit\\Tests\\": "modules/Audit/tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php vendor/bin/pest"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "lint": [
            "@php vendor/bin/pint"
        ],
        "lint:check": [
            "@php -r \"@unlink('storage/framework/cache/pint-check.cache');\"",
            "@php vendor/bin/pint --test --cache-file=storage/framework/cache/pint-check.cache"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --tag=livewire:assets --ansi --force",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
