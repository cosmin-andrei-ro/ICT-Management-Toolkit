# Copy to docker/production/.env and fill in. Keep the file private and back it up.

# The address people use. Caddy gets its HTTPS certificate for it automatically.
DOMAIN=toolkit.example.com
APP_URL=https://toolkit.example.com

# Make it with: docker compose -f docker/production/compose.yaml run --rm --no-deps app php artisan key:generate --show
# Without it, stored secrets cannot be read. Never change it once in use.
APP_KEY=

# For the privileged access vault: docker compose -f docker/production/compose.yaml run --rm --no-deps app php artisan pam:key
# Back it up apart from the database. Without it, stored credentials are lost.
PAM_KEY=

APP_NAME=ICT-Management-Toolkit
APP_DISPLAY_TIMEZONE=Europe/Bucharest
APP_SOURCE_URL=https://github.com/cosmin-andrei-ro/ICT-Management-Toolkit

# Long random passwords, used only between the containers
DB_PASSWORD=
REDIS_PASSWORD=

# Your mail server, for outgoing email
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=toolkit@example.com
MAIL_FROM_NAME=ICT-Management-Toolkit

# Every other setting is described in docs/installation.md and can be added here
