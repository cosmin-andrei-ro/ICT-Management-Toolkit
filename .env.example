APP_NAME=ICT-Management-Toolkit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_DISPLAY_TIMEZONE=Europe/Bucharest
APP_SOURCE_URL=https://github.com/cosmin-andrei-ro/ICT-Management-Toolkit

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Lock a local account after this many failed sign-ins in a row (0: never)
AUTH_LOCKOUT_AFTER=10
# Refuse passwords known from breaches (Have I Been Pwned, k-anonymity); false without internet access
AUTH_CHECK_BREACHED_PASSWORDS=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Active Directory authentication (see docs/adr/0007-active-directory-authentication.md)
LDAP_ENABLED=false
LDAP_HOSTS=
LDAP_PORT=636
LDAP_BASE_DN=
LDAP_USERNAME=
LDAP_PASSWORD=
LDAP_ENCRYPTION=ldaps
LDAP_CA_CERT=
LDAP_TIMEOUT=5
LDAP_ALLOW_INSECURE=false
LDAP_SYNC_SCHEDULE="*/15 * * * *"
SANCTUM_EXPIRATION=129600

# Email-to-ticket (see docs/development/email-to-ticket.md). Production keeps the defaults:
# TICKETING_MAIL_ALLOWED_PORTS=993,143
# TICKETING_MAIL_ALLOW_UNENCRYPTED=false
# Your mail server's authserv-id in Authentication-Results (e.g. mx.example.com), so headers forged by senders are ignored:
# TICKETING_MAIL_TRUSTED_AUTHSERV_IDS=

# Optional ClamAV daemon scanning uploads, e.g. tcp://clamav:3310 (ADR 0073). When set, files that cannot be scanned are refused.
ATTACHMENTS_CLAMD_ADDRESS=
# Reverse proxies terminating TLS in front of the application (addresses or CIDR, comma-separated).
TRUSTED_PROXIES=

# Contracts: reminder days before each deadline (end date minus notice period), and the proposed currency.
CONTRACT_REMINDER_DAYS=90,30
DEFAULT_CURRENCY=EUR

# Asset management: prefix of automatic asset tags, and days of warning before a warranty ends or a licence expires.
ITAM_TAG_PREFIX=AST
ITAM_WARRANTY_REMINDER_DAYS=30
ITAM_LICENSE_REMINDER_DAYS=60

# Business impact analysis: days before a process's review date when its owner is emailed.
BIA_REVIEW_REMINDER_DAYS=30

# Continuity plans: months until review and until the next exercise; days of notice before either.
BCM_REVIEW_MONTHS=12
BCM_EXERCISE_MONTHS=12
BCM_REMINDER_DAYS=30

# Application portfolio: months from a documentation version coming into force to its review; days of notice before a certificate expires.
APPLICATIONS_REVIEW_MONTHS=12
APPLICATIONS_CERTIFICATE_REMINDER_DAYS=30

# PDF documents (ADR 0030): URL of the optional Gotenberg service; empty = print from the browser.
GOTENBERG_URL=
APPLICATIONS_REVIEW_REMINDER_DAYS=30

# Risk register: days before a risk is due for reassessment when its owner is emailed.
RISK_REMINDER_DAYS=30

# Compliance: days before a control's periodic test when its owner is emailed.
AUDIT_TEST_REMINDER_DAYS=14

# Single sign-on (ADR 0038): allow plain HTTP identity providers, for a development identity provider only.
SSO_ALLOW_HTTP=false

# Outbound webhooks (ADR 0066): allow receivers on private networks or plain HTTP, for internal receivers only.
WEBHOOKS_ALLOW_PRIVATE_NETWORKS=false
WEBHOOKS_ALLOW_HTTP=false
WEBHOOKS_TIMEOUT=10
